<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/casino_canvas"
    tools:context=".SettingsActivity">

    <!-- Top Ambient Badge -->
    <TextView
        android:id="@+id/settingsBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_casino_pill"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.15"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="5dp"
        android:text="SYSTEM CONFIGURATION"
        android:textColor="@color/casino_emerald"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/anton"
        android:letterSpacing="0.05"
        android:shadowColor="@color/black"
        android:shadowRadius="4"
        android:text="GAMEPLAY SETTINGS"
        android:textColor="@color/white"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsBadge" />

    <!-- Audio Settings Card -->
    <LinearLayout
        android:id="@+id/soundCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_casino_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsTitle">

        <TextView
            android:id="@+id/soundTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.1"
            android:text="AUDIO CONTROLS"
            android:textColor="@color/casino_emerald"
            android:textSize="13sp" />

        <!-- Sound Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/rajdhani_medium"
                android:text="Sound Effects"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/casino_emerald"
                android:trackTint="@color/casino_card_border" />
        </LinearLayout>

        <!-- Volume Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_medium"
                android:text="Volume"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressBackgroundTint="@color/casino_card_border"
                android:progressTint="@color/casino_emerald"
                android:thumbTint="@color/casino_emerald" />

            <TextView
                android:id="@+id/volumeText"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anton"
                android:gravity="end"
                android:text="80%"
                android:textColor="@color/casino_emerald"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Gameplay Settings Card -->
    <LinearLayout
        android:id="@+id/gameCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_casino_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/soundCard">

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.1"
            android:text="TACTICAL GAMEPLAY"
            android:textColor="@color/casino_amber"
            android:textSize="13sp" />

        <!-- Vibration Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/rajdhani_medium"
                android:text="Haptic Feedback"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/vibrationSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/casino_amber"
                android:trackTint="@color/casino_card_border" />
        </LinearLayout>

        <!-- Timer Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/rajdhani_medium"
                android:text="Turn Countdown Timer"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/timerSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/casino_amber"
                android:trackTint="@color/casino_card_border" />
        </LinearLayout>

        <!-- Timer Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_medium"
                android:text="Limit"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/timerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="7"
                android:progress="4"
                android:progressBackgroundTint="@color/casino_card_border"
                android:progressTint="@color/casino_amber"
                android:thumbTint="@color/casino_amber" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anton"
                android:gravity="end"
                android:text="7 seconds"
                android:textColor="@color/casino_amber"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Save Settings Action Button -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_btn_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="saveSettings"
        android:text="SAVE SETTINGS"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gameCard" />

    <!-- Back Navigation Footer -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="Go Back"
        android:onClick="goBack"
        android:src="@drawable/backplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/backText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="goBack"
        android:text="BACK"
        android:textColor="@color/casino_text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/backButton"
        app:layout_constraintStart_toEndOf="@+id/backButton"
        app:layout_constraintTop_toTopOf="@+id/backButton" />

</androidx.constraintlayout.widget.ConstraintLayout>