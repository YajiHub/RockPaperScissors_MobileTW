<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/casino_canvas"
    tools:context=".showFinalHands">

    <!-- Enemy Final Card Container -->
    <ImageButton
        android:id="@+id/finalEnemyCard"
        android:layout_width="110dp"
        android:layout_height="154dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_casino_card"
        android:padding="8dp"
        android:tag="2"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/divider7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/finalEnemyChosen"
        android:layout_width="80dp"
        android:layout_height="84dp"
        android:layout_marginTop="14dp"
        android:clickable="false"
        android:focusable="false"
        android:tag="1"
        app:layout_constraintEnd_toEndOf="@+id/finalEnemyCard"
        app:layout_constraintStart_toStartOf="@+id/finalEnemyCard"
        app:layout_constraintTop_toTopOf="@+id/finalEnemyCard"
        app:srcCompat="@drawable/paper" />

    <TextView
        android:id="@+id/enemyFinal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="@font/black_ops_one"
        android:letterSpacing="0.05"
        android:tag="1"
        android:text="@string/paper"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/finalEnemyCard"
        app:layout_constraintEnd_toEndOf="@+id/finalEnemyCard"
        app:layout_constraintStart_toStartOf="@+id/finalEnemyCard" />

    <!-- Center Line & Result Banner -->
    <View
        android:id="@+id/divider7"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/casino_card_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Result Banner (Round Outcome) -->
    <TextView
        android:id="@+id/round"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_casino_pill"
        android:fontFamily="@font/black_ops_one"
        android:letterSpacing="0.1"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:shadowColor="@color/black"
        android:shadowRadius="8"
        android:text="@string/promptFinalWeapons"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/divider7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider7" />

    <!-- Player Final Card Container -->
    <ImageButton
        android:id="@+id/finalPlayerChosen"
        android:layout_width="110dp"
        android:layout_height="154dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_casino_card"
        android:padding="8dp"
        android:tag="2"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider7" />

    <ImageView
        android:id="@+id/finalPlayerCard"
        android:layout_width="80dp"
        android:layout_height="84dp"
        android:layout_marginTop="14dp"
        android:clickable="false"
        android:focusable="false"
        android:tag="1"
        app:layout_constraintEnd_toEndOf="@+id/finalPlayerChosen"
        app:layout_constraintStart_toStartOf="@+id/finalPlayerChosen"
        app:layout_constraintTop_toTopOf="@+id/finalPlayerChosen"
        app:srcCompat="@drawable/paper" />

    <TextView
        android:id="@+id/playerFinal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="@font/black_ops_one"
        android:letterSpacing="0.05"
        android:tag="1"
        android:text="@string/paper"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/finalPlayerChosen"
        app:layout_constraintEnd_toEndOf="@+id/finalPlayerChosen"
        app:layout_constraintStart_toStartOf="@+id/finalPlayerChosen" />

    <!-- Action Buttons (Shown after game completion) -->
    <Button
        android:id="@+id/tryAgain"
        android:layout_width="150dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="tryAgain"
        android:text="@string/tryAgain"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/playRR"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/playRR"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="playRR"
        android:text="@string/playRR"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/exit"
        android:layout_width="150dp"
        android:layout_height="44dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_secondary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="exit"
        android:text="@string/exit"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- Russian Roulette Mode Tie Warning Banner -->
    <TextView
        android:id="@+id/TieWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_casino_pill"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:shadowColor="@color/black"
        android:shadowRadius="6"
        android:text="@string/tieRR"
        android:textAlignment="center"
        android:textColor="@color/casino_amber"
        android:textSize="14sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>