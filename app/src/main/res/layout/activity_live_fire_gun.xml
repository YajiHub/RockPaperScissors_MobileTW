<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/firing_revolver_gun"
    tools:context=".LiveFireGun"
    tools:visibility="visible">

    <!-- Dark Scrim Overlay to ensure text readability against background gun graphic -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <!-- Result / Conclusion Banner -->
    <TextView
        android:id="@+id/conclusion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_casino_pill"
        android:fontFamily="@font/anton"
        android:letterSpacing="0.08"
        android:paddingStart="28dp"
        android:paddingTop="12dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp"
        android:shadowColor="@color/black"
        android:shadowRadius="12"
        android:text="@string/playerDies"
        android:textColor="@color/casino_crimson"
        android:textSize="28sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Action Buttons Stack -->
    <Button
        android:id="@+id/tryAgain"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="tryAgain"
        android:text="@string/tryAgain"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/playNormal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/playNormal"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="playNormal"
        android:text="@string/playNormal"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/exit"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_btn_secondary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.08"
        android:onClick="exit"
        android:text="@string/exit"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="invisible"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>