<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/casino_surface_elevated" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/casino_emerald" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/casino_surface_card" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/casino_card_border" />
        </shape>
    </item>
</selector>
